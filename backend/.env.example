APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5455
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=docseq_dms
DB_SSLMODE=disable

# Usuário admin criado automaticamente no boot, caso ainda não exista.
# DEFAULT_ADMIN_PASSWORD é OBRIGATÓRIA quando APP_ENV=production
# (o app falha no startup se estiver ausente nesse ambiente).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@docse9.local
DEFAULT_ADMIN_PASSWORD=admin123

# Município vinculado ao admin padrão, usado só se nenhum município existir ainda
DEFAULT_MUNICIPALITY_NAME=Matriz
DEFAULT_MUNICIPALITY_UF=PB
